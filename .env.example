# ShilpAI Environment Variables Configuration

# Application
PROJECT_NAME="ShilpAI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
PORT=8000
HOST="127.0.0.1"

# Security (Change in production!)
SECRET_KEY="shilpai_secure_production_secret_key_change_me_987654321"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# SQLite (Default local lightweight demonstration)
DATABASE_URL="sqlite:///./shilpai.db"

# PostgreSQL (Production ready)
# DATABASE_URL="postgresql://shilpai_user:shilpai_secure_pass@localhost:5432/shilpai_db"

# Storage
UPLOAD_DIR="./uploads"

# Optional External AI Services (Fallback heuristics & Pillow vision active if unconfigured)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
SPEECH_PROVIDER="browser" # options: browser, whisper
